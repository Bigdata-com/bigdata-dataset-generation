# Copy to .env and fill in. Never commit the real file.
# Real environment variables take precedence over this file, so a platform that injects
# secrets as env vars works without changing anything here.

# The search.
BIGDATA_API_KEY=

# Optional. The teacher and the student base are public and ungated, so they download
# into models/ without it. Set it only if the anonymous rate limit bites on the ~60 GB pull.
HF_TOKEN=
